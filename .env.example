# Supabase (Projekt-Region eu-central-1 Frankfurt)
# aus Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NUR serverseitig verwenden (Route Handlers / Server Actions).
# Niemals im Client-Bundle!
SUPABASE_SERVICE_ROLE_KEY=

# Öffentliche App-URL (für Metadaten, Web Push, Signed-URL-Redirects)
NEXT_PUBLIC_APP_URL=https://shotrace.gschpusi.com

# Optional: Web-Push (Phase 1). Ohne diese Werte funktionieren In-App-
# Benachrichtigungen trotzdem; nur der Server-Versand per Push ruht.
# (Für echten Versand zusätzlich nötig: push_subscriptions-Tabelle als Migration
#  + Sender, z. B. Supabase Edge Function auf notifications-Insert.)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
